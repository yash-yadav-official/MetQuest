# -*- coding: utf-8 -*-
#BEGIN_HEADER
import os
import sys
from unittest.mock import patch

# 1. The Cloud Path Injection
# KBase mounts the repo to /kb/module. We force Python to see the Raman Lab code.
module_path = os.path.abspath(os.path.join("/kb/module", "lib", "metquest_core"))
if module_path not in sys.path:
    sys.path.append(module_path)

# Now it is safe to import the original execution engine
from metquest.execute_metquest import execute_all_codes
#END_HEADER


class MetQuest:
    '''
    Module Name:
    MetQuest

    Module Description:
    A KBase module that wraps the Raman Lab MetQuest graph traversal algorithm.
    '''

    ######## WARNING FOR GEVENT USERS ####### noqa
    # Since asynchronous IO can lead to methods - even the same method -
    # interrupting each other, you must be *very* careful when using global
    # state. A method could easily clobber the state set by another while
    # the latter method is running.
    ######################################### noqa
    VERSION = "0.0.1"
    GIT_URL = ""
    GIT_COMMIT_HASH = ""

    #BEGIN_CLASS_HEADER
    #END_CLASS_HEADER

    # config contains contents of config file in a hash or None if it couldn't
    # be found
    def __init__(self, config):
        #BEGIN_CONSTRUCTOR
        self.callback_url = os.environ['SDK_CALLBACK_URL']
        self.shared_folder = config['scratch']
        #END_CONSTRUCTOR
        pass


    def run_MetQuest(self, ctx, params):
        """
        :param params: instance of mapping from String to unspecified object
        :returns: instance of type "ReportResults"
        """
        # ctx is the context object
        # return variables are: output
        #BEGIN run_MetQuest

        print("Initializing MetQuest Wrapper...")

        # 2. The Wrapper Architecture
        # Create the nested "batch_1" folder inside the KBase scratch drive
        wrapper_dir = os.path.join(self.shared_folder, "mq_sandbox")
        target_dir = os.path.join(wrapper_dir, "batch_1")
        os.makedirs(target_dir, exist_ok=True)

        # --- DATA STAGING ---
        # (Your code to download the KBase SBML model and write seed_mets.txt, 
        # source_mets.txt, and target_mets.txt into target_dir goes here)
        

        # 3. The Logic Bug Bypass
        # Fetch pathway length from the UI (default to 5). 
        # Write 1 through N to cutoff.txt to guarantee the engine matches a path length.
        user_cutoff = int(params.get('pathway_length', 5))
        
        cutoff_file_path = os.path.join(target_dir, 'cutoff.txt')
        with open(cutoff_file_path, 'w') as f:
            for i in range(1, user_cutoff + 1):
                f.write(f"{i}\n")

        # 4. The Hijacked Execution
        print(f"Auto-feeding execution path to engine: {wrapper_dir}")
        
        try:
            # Intercept the 'input()' prompt and feed it the wrapper directory
            with patch('builtins.input', return_value=wrapper_dir):
                execute_all_codes()
            print("--- METQUEST ENGINE COMPLETED SUCCESSFULLY ---")
            
        except Exception as e:
            print("\n--- METQUEST ENGINE CRASHED ---")
            import traceback; traceback.print_exc()
            raise ValueError(f"MetQuest algorithm failed during execution: {e}")

        # --- HTML REPORTING ---
        # (Your code to package target_dir/Results/ into an HTML KBaseReport goes here)

        output = {
            'report_name': 'MetQuest_Report',
            'report_ref': 'Workspace_Report_Ref' # Replace with actual report reference
        }

        #END run_MetQuest

        # At some point might do deeper type checking...
        if not isinstance(output, dict):
            raise ValueError('Method run_MetQuest return value ' +
                             'output is not type dict as required.')
        # return the results
        return [output]

    def status(self, ctx):
        #BEGIN_STATUS
        returnVal = {'state': "OK",
                     'message': "",
                     'version': self.VERSION,
                     'git_url': self.GIT_URL,
                     'git_commit_hash': self.GIT_COMMIT_HASH}
        #END_STATUS
        return [returnVal]
