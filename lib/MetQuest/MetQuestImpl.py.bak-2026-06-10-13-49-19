# -*- coding: utf-8 -*-
#BEGIN_HEADER
import os
import sys
import logging
import cobra
from installed_clients.DataFileUtilClient import DataFileUtil
from installed_clients.KBaseReportClient import KBaseReport
from metquest.execute_metquest import execute_all_codes
#END_HEADER


class MetQuest:
    '''
    Module Name:
    MetQuest

    Module Description:
    A KBase module: MetQuest
    '''

    ######## WARNING FOR GEVENT USERS ####### noqa
    # Since asynchronous IO can lead to methods - even the same method -
    # interrupting each other, you must be *very* careful when using global
    # state. A method could easily clobber the state set by another while
    # the latter method is running.
    ######################################### noqa
    VERSION = "0.0.1"
    GIT_URL = ""
    GIT_COMMIT_HASH = "HEAD"

    #BEGIN_CLASS_HEADER
    #END_CLASS_HEADER

    # config contains contents of config file in a hash or None if it couldn't
    # be found
    def __init__(self, config):
        #BEGIN_CONSTRUCTOR
        self.callback_url = os.environ.get('SDK_CALLBACK_URL')
        self.shared_folder = config['scratch']
        logging.basicConfig(format='%(created)f - %(levelname)s - %(message)s',
                            level=logging.INFO)
        #END_CONSTRUCTOR
        pass


    def run_metquest(self, ctx, params):
        """
        :param params: instance of type "MetQuestParams" -> structure:
           parameter "workspace_name" of String, parameter "input_fba_model"
           of String, parameter "seeds" of list of String, parameter
           "sources" of list of String, parameter "targets" of list of
           String, parameter "cutoff" of Long
        :returns: instance of type "MetQuestResults" -> structure: parameter
           "report_name" of String, parameter "report_ref" of String
        """
        # ctx is the context object
        # return variables are: output
        #BEGIN run_metquest
        logging.info("Starting MetQuest execution pipeline...")
        dfu = DataFileUtil(self.callback_url)
        
        # 1. Establish the directory structure MetQuest requires
        run_dir = os.path.join(self.shared_folder, 'metquest_run')
        os.makedirs(run_dir, exist_ok=True)
        
        # 2. Pull down the KBase Cloud FBAModel and convert it to a local SBML XML file
        logging.info(f"Downloading FBA model reference: {params['input_fba_model']}")
        model_data = dfu.export_model_as_sbml({'input_ref': params['input_fba_model']})
        sbml_path = os.path.join(run_dir, 'model.xml')
        os.rename(model_data['path'], sbml_path)
        
        # 3. Read the model via Cobra to extract the exact <model id>
        try:
            cobra_model = cobra.io.read_sbml_model(sbml_path)
            model_id = cobra_model.id
            logging.info(f"Successfully extracted Model ID prefix: {model_id}")
        except Exception as e:
            raise ValueError(f"Failed to parse SBML Model via Cobra: {str(e)}")

        # 4. Helper function to format and prefix metabolites to avoid the validation trap
        def write_prefixed_file(filename, input_list):
            file_path = os.path.join(run_dir, filename)
            with open(file_path, 'w') as f:
                for item in input_list:
                    clean_item = item if item.startswith(model_id) else f"{model_id} {item}"
                    f.write(f"{clean_item}\n")

        # 5. Write the 4 configuration text files out to the drive
        write_prefixed_file('seed_mets.txt', params['seeds'])
        write_prefixed_file('source_mets.txt', params['sources'])
        write_prefixed_file('target_mets.txt', params['targets'])
        
        with open(os.path.join(run_dir, 'cutoff.txt'), 'w') as f:
            f.write(f"{str(params['cutoff'])}\n")

        # 6. Execute the MetQuest Engine Programmatically
        logging.info("Launching MetQuest dynamic programming search...")
        try:
            execute_all_codes(run_dir, run_dir) 
        except Exception as e:
            raise RuntimeError(f"MetQuest core execution engine crashed: {str(e)}")

        # 7. Package and upload the resulting pathway arrays back to KBase
        report_client = KBaseReport(self.callback_url)
        report_info = report_client.create_extended_report({
            'message': 'MetQuest graph compilation and pathway search completed successfully.',
            'workspace_name': params['workspace_name']
        })

        output = {
            'report_name': report_info['name'],
            'report_ref': report_info['ref']
        }
        #END run_metquest
        
        # At some point might do deeper type checking...
        if not isinstance(output, dict):
            raise ValueError('Method run_metquest return value ' +
                             'output is not type dict as required.')
        # return the results
        return [output]
    def status(self, ctx):
        #BEGIN_STATUS
        returnVal = {'state': "OK",
                     'message': "",
                     'version': self.VERSION,
                     'git_url': self.GIT_URL,
                     'git_commit_hash': self.GIT_COMMIT_HASH}
        #END_STATUS
        return [returnVal]
