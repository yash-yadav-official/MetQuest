{
    "ver": "0.0.1",
    "authors": [
        "yashyadav"
    ],
    "contact": "https://github.com/yash-yadav-official/MetQuest/issues",
    "visible": true,
    "categories": [
        "active",
        "metabolic_modeling"
    ],
    "widgets": {
        "input": null,
        "output": "no-display"
    },
    "parameters": [
        {
            "id": "input_fba_model",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "" ],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": [ "KBaseFBA.FBAModel" ]
            }
        },
        {
            "id": "seeds",
            "optional": false,
            "advanced": false,
            "allow_multiple": true,
            "default_values": [
                "cpd00001_c0",
                "cpd00002_c0",
                "cpd00003_c0",
                "cpd00004_c0",
                "cpd00005_c0",
                "cpd00006_c0",
                "cpd00007_c0",
                "cpd00008_c0",
                "cpd00009_c0",
                "cpd00011_c0",
                "cpd00013_c0",
                "cpd00048_c0",
                "cpd00067_c0",
                "cpd00205_c0",
                "cpd00027_e0"
            ],
            "field_type": "text"
        },
        {
            "id": "sources",
            "optional": false,
            "advanced": false,
            "allow_multiple": true,
            "default_values": [
                "cpd00079_c0"
            ],
            "field_type": "text"
        },
        {
            "id": "targets",
            "optional": false,
            "advanced": false,
            "allow_multiple": true,
            "default_values": [
                "cpd00020_c0"
            ],
            "field_type": "text"
        },
        {
            "id": "cutoff",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [ "15" ],
            "field_type": "text",
            "text_options": {
                "validate_as": "int",
                "min_int": 1,
                "max_int": 50
            }
        }
    ],
    "behavior": {
        "service-mapping": {
            "url": "",
            "name": "MetQuest",
            "method": "run_metquest",
            "input_mapping": [
                {
                    "narrative_system_variable": "workspace",
                    "target_property": "workspace_name"
                },
                {
                    "input_parameter": "input_fba_model",
                    "target_property": "input_fba_model"
                },
                {
                    "input_parameter": "seeds",
                    "target_property": "seeds"
                },
                {
                    "input_parameter": "sources",
                    "target_property": "sources"
                },
                {
                    "input_parameter": "targets",
                    "target_property": "targets"
                },
                {
                    "input_parameter": "cutoff",
                    "target_property": "cutoff"
                }
            ],
            "output_mapping": [
                {
                    "service_method_output_path": [0, "report_name"],
                    "target_property": "report_name"
                },
                {
                    "service_method_output_path": [0, "report_ref"],
                    "target_property": "report_ref"
                }
            ]
        }
    },
    "job_id_output_field": "docker"
}
